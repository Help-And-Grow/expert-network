generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // SCF Nodejs18.15 runs on Tencent Linux (RHEL-derived, OpenSSL 3.x). The
  // `native` target builds for the dev machine; the linux targets are
  // required so the standalone bundle that ships to SCF contains a runnable
  // query engine. Migrations are run separately from a Tencent Cloud machine
  // (see infra/tencent-cn/scripts/migrate.sh).
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Prisma 7 forbids `url = env(...)` here — connection URL is resolved by
  // `prisma.config.ts` (DIRECT_URL → DATABASE_URL). Production points at
  // Google Cloud SQL (asia-southeast1). Use Prisma 7+ CLI to generate.
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String             @id @default(cuid())
  name              String?
  nickName          String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  telegramId        String?            @unique
  telegramUsername  String?
  wechatOpenId      String?            @unique
  wechatUnionId     String?
  inviteCode        String?
  tokenBalance      Int                @default(0)
  accounts          Account[]
  bookingsAsFounder Booking[]          @relation("FounderBookings")
  expert            Expert?
  membership        Membership?
  membershipLedger  MembershipLedger[]
  reviews           Review[]
  sessions          Session[]
  tokenLedger       TokenLedger[]
}

model Expert {
  id                  String           @id @default(cuid())
  userId              String           @unique
  linkedIn            String?
  website             String?
  twitter             String?
  substack            String?
  instagram           String?
  xiaohongshu         String?
  gender              String?
  tonWalletAddress    String?
  tonWalletType       String?
  tonMnemonicEnc      String?
  priceOnlineCents    Int?
  priceOfflineCents   Int?
  currency            String           @default("SGD")
  stripeAccountId     String?
  stripeAccountStatus String?          @default("none")
  /// WeChat Pay sub-merchant id (特约商户号) when using service-provider / profit-sharing mode
  wechatSubMchId      String?
  weeklySchedule      Json?
  sessionType         SessionType      @default(BOTH)
  bio                 String?
  audioIntroUrl       String?
  fishAudioModelId    String?
  mem9SpaceId         String?
  servicesOffered     Json?
  /// ISO 3166-1 alpha-2 country/region codes the expert is familiar with.
  /// Stored uppercase. Validated + normalized through src/lib/expert-countries.ts.
  countries           Json?
  documentName        String?
  documentData        String?
  avatarVideoUrl      String?
  avatarScript        String?
  onboardingStep      OnboardingStep   @default(SOCIAL_LINKS)
  isPublished         Boolean          @default(false)
  isVerified          Boolean          @default(false)
  avgRating           Float            @default(0)
  reviewCount         Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  availableSlots      AvailableSlot[]
  bookings            Booking[]
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pompCredentials     POMPCredential[]
  reviews             Review[]
}

model AvailableSlot {
  id        String   @id @default(cuid())
  expertId  String
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([expertId, startTime])
}

model Booking {
  id                      String           @id @default(cuid())
  expertId                String
  founderId               String
  sessionType             SessionType
  startTime               DateTime
  endTime                 DateTime
  timezone                String           @default("Asia/Singapore")
  meetingLink             String?
  offlineAddress          String?
  status                  BookingStatus    @default(PENDING)
  cancelledBy             String?
  cancelReason            String?
  totalAmountCents        Int?
  depositAmountCents      Int?
  tokenDiscount           Int?             @default(0)
  tokensRedeemed          Int?             @default(0)
  currency                String           @default("SGD")
  paymentMethod           String?
  paymentStatus           String           @default("pending")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  wechatTransactionId     String?
  stripeCustomerId        String?
  stripePaymentMethodId   String?
  stripeRemainderPIId     String?
  paynowReference         String?
  paynowPayerReference    String?
  paynowSubmittedAt       DateTime?
  paynowConfirmedAt       DateTime?
  tonDepositTxHash        String?
  tonRemainderTxHash      String?
  remainderChargedAt      DateTime?
  isPremiumLive           Boolean          @default(false)
  liveRoomId              String?          @unique
  liveDurationMinutes     Int?
  liveAccessChargedAt     DateTime?
  /// WeChat profit-sharing: pending | success | failed | skipped (null = not applicable or not yet processed)
  wechatProfitShareStatus String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  expert                  Expert           @relation(fields: [expertId], references: [id], onDelete: Cascade)
  founder                 User             @relation("FounderBookings", fields: [founderId], references: [id], onDelete: Cascade)
  pompCredentials         POMPCredential[]
  review                  Review?
  tokenLedgerEntries      TokenLedger[]

  @@index([expertId, startTime])
  @@index([founderId])
}

model Review {
  id               String    @id @default(cuid())
  bookingId        String    @unique
  expertId         String
  founderId        String
  rating           Int
  comment          String?
  expertSuggestion String?
  suggestionAt     DateTime?
  createdAt        DateTime  @default(now())
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  expert           Expert    @relation(fields: [expertId], references: [id], onDelete: Cascade)
  founder          User      @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([expertId])
  @@index([founderId])
  @@index([bookingId])
}

model InvitationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(10)
  usedCount Int       @default(0)
  createdBy String?
  note      String?
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model POMPCredential {
  id              String   @id @default(cuid())
  expertId        String
  bookingId       String
  recipientRole   String
  attestationUID  String   @unique
  recipient       String?
  hours           Float
  /// Base/Optimism tx hash that included the EAS Attested event. Written
  /// eagerly by `issuePOMPCredentials` after `tx.wait()` returns, so it's
  /// populated even before the Alchemy webhook fires.
  txHash          String?
  /// Confirmed on-chain. Set to true eagerly when our own backend issues
  /// the attestation (the EAS receipt itself proves inclusion); also set
  /// idempotently by the Alchemy webhook for redundancy or external
  /// attestations.
  onChainVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  expert          Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([bookingId, recipientRole])
  @@index([expertId])
  @@index([expertId, onChainVerified])
}

model TokenLedger {
  id          String   @id @default(cuid())
  userId      String
  bookingId   String?
  type        String
  amount      Int
  description String?
  createdAt   DateTime @default(now())
  booking     Booking? @relation(fields: [bookingId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
}

/// Current membership entitlement for a user. One row per user, only created
/// when the user first subscribes — absence of a row is the canonical "no
/// membership" signal. Kept as a separate table (rather than columns on
/// User) so the User model stays unaffected by a feature that's gated to
/// the WeChat MP path; this prevents schema-drift fallout in unrelated
/// queries that select User columns.
model Membership {
  id           String         @id @default(cuid())
  userId       String         @unique
  tier         MembershipTier
  /// When the current paid window ends. extendMembership() bumps this
  /// forward; hasActiveMembership() checks it (with a 5-min grace).
  currentUntil DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentUntil])
}

/// Subscription / membership transaction log. Each row is one purchase or
/// adjustment that extends a user's `Membership.currentUntil`. Source-of-truth
/// for reconciliation against WeChat Pay (CN/Intl appIds) and any future
/// Stripe subscription rails. Membership gates premium-live access on the
/// WeChat Mini Program path (no H&G token charge there).
model MembershipLedger {
  id           String         @id @default(cuid())
  userId       String
  tier         MembershipTier
  /// Days the purchase added to currentUntil. Negative for adjustments.
  durationDays Int
  /// Amount paid in the smallest unit of `currency` (e.g. CNY fen, USD cents).
  amountMinor  Int            @default(0)
  currency     String         @default("CNY")
  /// "wechat-pay-cn", "wechat-pay-intl", "stripe", "manual", "refund".
  source       String
  /// External transaction id (WeChat transaction_id, Stripe invoice id, ...).
  externalRef  String?        @unique
  /// What `Membership.currentUntil` became after this entry was applied
  /// (audit trail). Null only on adjustments that don't change the date.
  currentUntil DateTime?
  description  String?
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
}

enum UserRole {
  USER
  ADMIN
}

/// Membership tier for premium-live access on WeChat MP. NONE = no active
/// membership. BASIC / PRO leave room for future tiered pricing without
/// another migration.
enum MembershipTier {
  NONE
  BASIC
  PRO
}

enum SessionType {
  ONLINE
  OFFLINE
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OnboardingStep {
  SOCIAL_LINKS
  DOMAINS
  SESSION_PREFS
  AI_GENERATION
  PREVIEW
  PUBLISHED
}

/// Per-environment scoped key/value config. Until Phase 2 of the admin-page
/// revamp this used `key` as the primary key (single global value). The
/// (key, environment) compound is now unique so production / preview /
/// development can hold independent values for the same key — useful when
/// rotating providers in preview without affecting production traffic.
/// `environment` defaults to "production" so legacy single-env callers keep
/// working unchanged.
model SystemConfig {
  id          String   @id @default(cuid())
  key         String
  value       String
  environment String   @default("production")
  updatedAt   DateTime @updatedAt

  @@unique([key, environment])
  @@index([environment])
}

/// Append-only audit trail for provider/system-config changes made via
/// the admin Providers page (or any code path that calls the helpers in
/// `src/lib/system-config.ts` / `src/lib/admin/provider-registry.ts`).
/// Rows are written transactionally with the change itself so a successful
/// apply always leaves a complete audit footprint; a Vercel-deploy failure
/// after commit does NOT roll back the audit row (that's the point — we
/// want to know the DB changed even if the deploy didn't).
model ProviderConfigChange {
  id          String   @id @default(cuid())
  changedAt   DateTime @default(now())
  /// null = system / cron job (no admin attribution).
  actorEmail  String?
  /// 'ADMIN' | 'SYSTEM'
  actorRole   String?
  /// 'llm' | 'storage' | 'system-config' | 'registry'
  category    String
  /// SystemConfig key (e.g. 'AI_PROVIDER') or 'registry:llm:openai' for
  /// ProviderRegistry rows.
  configKey   String
  /// 'production' | 'preview' | 'development' — registry rows are global
  /// and store 'production' here for filtering convenience.
  environment String   @default("production")
  before      Json?
  after       Json?
  /// Optional admin-supplied note ("rotating leaked OpenAI key").
  reason      String?
  createdAt   DateTime @default(now())

  @@index([changedAt])
  @@index([category, configKey])
  @@index([environment, changedAt])
}

/// Registry of pluggable providers (LLM, storage, voice, image, ...).
/// Adding a new provider should be a one-row insert + thin adapter, not a
/// 6-file edit. The admin page at `/admin/providers` is the read/write UI.
model ProviderRegistry {
  id          String   @id @default(cuid())
  category    String // 'llm' | 'storage' | (future: 'voice' | 'image')
  key         String // 'openai' | 'qwen' | 'vercel-blob' | 'gcs' | ...
  displayName String
  enabled     Boolean  @default(true)
  envKeys     Json // { apiKey: 'OPENAI_API_KEY', baseUrl: 'OPENAI_BASE_URL', ... }
  models      Json // { text: { envKey: 'OPENAI_TEXT_MODEL', default: 'gpt-4o' }, image: {...} }
  metadata    Json? // free-form: capabilities, regions, notes
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, key])
  @@index([category, enabled, sortOrder])
}

/// Per-surface provider routing scopes (Phase 3 admin revamp). A scope binds
/// a request shape (WeChat-Intl, WeChat-CN, Web/Telegram, ...) to an ordered
/// chain of provider keys. The resolver in `src/lib/ai/routing.ts` evaluates
/// scopes in priority ASC order and the first whose `matchRules` matches the
/// request origin wins. Empty `matchRules: {}` is the catch-all.
///
/// Categories: 'llm' | 'image' | 'voice' | 'storage'. Per-environment scoped
/// so preview can route differently from production.
model ProviderRoutingScope {
  id          String   @id @default(cuid())
  scopeKey    String // 'web-default' | 'wechat-intl' | 'wechat-cn' | 'telegram-default'
  displayName String
  description String?
  category    String // 'llm' | 'image' | 'voice' | 'storage'
  chain       Json // ordered string[] of provider keys, e.g. ["qwen","gemini"]
  enabled     Boolean  @default(true)
  /// { isWeChat?: boolean, region?: 'intl'|'cn', userAgent?: string, header?: {...} }
  matchRules  Json
  /// Lower = checked first. Catch-all scopes use 200, specific scopes 100.
  priority    Int      @default(100)
  environment String   @default("production")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scopeKey, category, environment])
  @@index([category, enabled, priority])
}

/// Per-route chain overrides (Phase 3 admin revamp). When the request hits
/// a path matching `routePattern`, this chain wins over the scope's chain.
/// `routePattern` supports `startsWith` and a single trailing `*` wildcard
/// (no regex). Empty by default; admins add overrides via `/admin/providers`.
model ProviderRouteOverride {
  id            String   @id @default(cuid())
  routePattern  String // '/api/match' | '/api/voice-chat/*'
  category      String // 'llm' | 'image' | 'voice' | 'storage'
  chainOverride Json // ordered string[]
  enabled       Boolean  @default(true)
  /// Operator note: why this override exists.
  reason        String?
  environment   String   @default("production")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([routePattern, category, environment])
  @@index([enabled, environment])
}

/// Drift between SystemConfig (DB) and Vercel project env. Populated by the
/// `/api/cron/provider-drift` job. Each row is a snapshot of a single key
/// found to differ at scan time. The admin resolves drift by either pushing
/// DB→Vercel, pulling Vercel→DB, or marking it intentional.
model ProviderConfigDrift {
  id           String    @id @default(cuid())
  detectedAt   DateTime  @default(now())
  configKey    String
  environment  String
  dbValue      String?
  vercelValue  String?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedNote String?

  @@index([resolved, detectedAt])
  @@index([configKey, environment])
}
