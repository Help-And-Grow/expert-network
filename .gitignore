# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth)
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# Playwright saved login (never commit)
e2e/.auth/*.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.production
.env.development
.env.staging
# Explicit: `vercel env pull --environment production` (contains live secrets)
.env.vercel.production.local
# Local file for `npm run vercel:env:apply` (never commit secrets)
.env.vercel.sync
.env.vercel*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# WeChat Mini Program CI private key (never commit; download from MP admin)
private.*.key
wechat/private.*.key
.cursor/mcp.json
expert-network.code-workspace

# Locally pulled env snapshots (never commit)
.env.prod
.env.pulled
.env.vercel.*.local

# Database dumps — production data must never enter git history.
# (Prisma migrations live at prisma/migrations/<ts>/migration.sql and are not
# matched by these patterns.)
*.dump
*.psql
*-dump.sql
*_data.sql
*_backup.sql
# Belt-and-suspenders: block re-adding the file that triggered the
# 2026-05-11 history rewrite (see backup/pre-secret-cleanup-20260511).
wechat/helpandgrow_data.sql
