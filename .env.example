# Production: DATABASE_URL, NEXTAUTH_URL, and AUTH_SECRET or NEXTAUTH_SECRET (32+ chars) are validated at startup.
# Auth.js v5 prefers AUTH_SECRET; NEXTAUTH_SECRET still works as an alias.
# Emergency bypass (not for Vercel): SKIP_ENV_VALIDATION=1
#
# Vercel env (pull locally after `vercel link` + `vercel login` — never commit pulled files)
#   npm run vercel:env:pull:dev        → .env.vercel.development.local
#   npm run vercel:env:pull:preview    → .env.vercel.preview.local
#   npm run vercel:env:pull:production → .env.vercel.production.local
# List names only: npm run vercel:env:list:production
# Compare keys across pulled files (no values): npm run vercel:env:compare-keys
# See docs/references/vercel-environments-solo-pm.md
#
# Vercel CLI — push many vars at once: put KEY=value lines in `.env.vercel.sync` (gitignored), then:
#   npm run vercel:env:apply -- production ./.env.vercel.sync
# Requires `vercel link` + `vercel login`. Inspect: `npm run vercel:env:ls` or `vercel:env:list:production`; pull: see commands above.

# Optional: mirror expert memories to Postgres pgvector (run admin/migrate on Postgres first; needs OPENAI_API_KEY for embeddings)
#USE_PGVECTOR_MEMORY=1
#PGVECTOR_DATABASE_URL="postgresql://..."  # defaults to DATABASE_URL when Postgres

# Optional: Inngest — register https://YOUR_DOMAIN/api/inngest in Inngest Cloud; set signing key on Vercel
#INNGEST_SIGNING_KEY=""
#INNGEST_EVENT_KEY=""
# When Inngest runs the daily remainder job, skip Vercel cron work:
#CRON_DELEGATED_TO_INNGEST=1

# Database (Prisma) — postgresql:// or postgres://
DATABASE_URL="postgresql://user:password@localhost:5432/expert_network?schema=public"
# Vercel Marketplace Supabase: integration often sets POSTGRES_PRISMA_URL (pooled) instead of DATABASE_URL;
# runtime maps it automatically. See docs/references/vercel-supabase-marketplace.md
#POSTGRES_PRISMA_URL=""

# NextAuth / Auth.js v5
NEXTAUTH_URL="http://localhost:3000"
# Production: prefer AUTH_SECRET (Vercel). NEXTAUTH_SECRET still works as an alias in code.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
#NEXTAUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Places API (New) — offline meetup address autocomplete (≥4 characters → suggestions; postal codes work).
# Cloud Console: enable "Places API (New)"; restrict key to server IP or your domains as needed.
#GOOGLE_PLACES_API_KEY=""
# Optional comma-separated ISO country codes (default: sg). Example: sg,my
#GOOGLE_PLACES_REGION_CODES="sg"

# Local dev only (`next dev`): enables "Continue as local dev" on /auth/signin — no Google or magic link.
#DEV_AUTH_EMAIL="dev@localhost"
#DEV_AUTH_ROLE="ADMIN"  # optional; USER when unset

# Production-safe hidden browser E2E login. No sign-in button is shown.
# Set these only on the deployments you want to verify with Playwright.
#E2E_AUTH_EMAIL="e2e-admin@example.com"
#E2E_AUTH_ROLE="ADMIN"  # optional; ADMIN when unset
#E2E_AUTH_TOKEN="generate-a-long-random-token-at-least-24-chars"

# Email (Magic Link) — Nodemailer in src/auth.ts; provider id is "nodemailer".
#
# Path A — Gmail SMTP: FROM must be the same Gmail address as EMAIL_SERVER_USER (or a Gmail
# "Send mail as" verified alias). Use an App Password if the account has 2FA.
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="you@gmail.com"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Help and Grow <you@gmail.com>"
#
# Resend API — booking confirmation + 1h reminders only (`src/lib/email.ts`). Not used for magic-link sign-in.
# Free tier: recipients are restricted (e.g. your signup email / verified test inboxes). Use for internal QA until
# you verify a domain and upgrade for real user emails.
RESEND_API_KEY=""
RESEND_EMAIL_FROM="Help & Grow <onboarding@resend.dev>"
#
# Optional: magic link via Resend SMTP instead of Gmail — set EMAIL_* to smtp.resend.com / user resend / API key as password; then EMAIL_FROM must match Resend rules.

# Stripe — booking checkout (`/api/bookings/checkout`). Set STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET in Vercel (not committed).
# Paste raw secret values only: no surrounding quotes, trailing spaces, or literal `\n` suffixes.
# Payment methods (when enabled in Dashboard): PayNow → GrabPay → WeChat Pay → Alipay → card.
# Apple Pay / Google Pay: enable in Dashboard; they show on the card step (verify domain for Apple Pay in Dashboard).
# Opt out of a method if session creation errors in test or a region does not support it:
#STRIPE_CHECKOUT_GRABPAY="false"
#STRIPE_CHECKOUT_WECHAT_PAY="false"
#STRIPE_CHECKOUT_ALIPAY="false"

# PayNow (Singapore) — primary web payment flow
# UEN of receiving entity, e.g. 201403121W
PAYNOW_UEN=""
# Displayed in QR merchant name (max 25 ASCII chars)
PAYNOW_COMPANY_NAME="Help & Grow"
# true => sender can edit amount; false => amount locked from booking
PAYNOW_EDITABLE_AMOUNT="false"

# AI Provider — Help-And-Grow public repo defaults to Alibaba Cloud Qwen / DashScope,
# but /admin/ai-provider can switch providers and pin explicit model IDs per deployment.
# Profile-image fallback order is: openai -> zai -> qwen -> gemini -> dedalus.
AI_PROVIDER="qwen"
# Local dev only: mimic the Alibaba Cloud showcase deployment.
#VENDOR_ALIBABACLOUD_DEMO="1"

# --- Gemini (required when AI_PROVIDER=gemini) ---
# Also needed for Google Search grounding & PDF extraction in qwen/openai modes.
#
# Option A: Vertex AI (recommended — uses GCP credits, higher quotas)
#   1. Enable Vertex AI API at console.cloud.google.com
#   2. Provide a base64-encoded service-account JSON on Vercel
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_SERVICE_ACCOUNT_KEY=""
GEMINI_TEXT_MODEL="gemini-3-flash-preview"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
# Optional: Vertex region for profile image generation only. Use when GOOGLE_CLOUD_LOCATION is e.g. asia-southeast1
# (text OK there) but gemini-3.1-flash-image-preview is unavailable — defaults to global or a supported region.
#GEMINI_IMAGE_VERTEX_LOCATION="global"
#
# Option B: AI Studio API key (simpler, free tier has limited image quota)
#   Get your key at https://aistudio.google.com
GEMINI_API_KEY=""

# Gemini is optional in this repo now. Public voice chat and TTS are standardized on DashScope / Qwen.
# Keep Gemini only if you explicitly want its grounding or PDF extraction helpers for local/private workflows.
#GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
#GEMINI_TTS_VOICE_MALE="Charon"
#GEMINI_TTS_VOICE_FEMALE="Kore"

# --- Qwen / DashScope (required when AI_PROVIDER=qwen) ---
#   Get your key at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=""
QWEN_TEXT_MODEL="qwen3.6-plus"
QWEN_IMAGE_MODEL="wan2.7-image-pro"

# --- OpenAI (required when AI_PROVIDER=openai) ---
#   Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5.2"
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# --- BytePlus ModelArk (required when AI_PROVIDER=byteplus) ---
BYTEPLUS_API_KEY=""
BYTEPLUS_MODEL_ID="ep-2025xxxxxx-yyyy" # ModelArk endpoint ID (e.g. for doubao-seed-1.6-flash)
# BytePlus only affects routes that still honor AI_PROVIDER.
# Voice chat remains on DashScope / Qwen regardless of AI_PROVIDER.

# --- Volcengine ModelArk (required when AI_PROVIDER=volcengine) ---
VOLCENGINE_API_KEY=""
VOLCENGINE_MODEL_ID="ep-2025xxxxxx-yyyy" # ModelArk endpoint ID (e.g. for doubao-seed-1.6-flash)

# --- Z.ai (required when AI_PROVIDER=zai) ---
# Preferred path for this repo: Vertex AI-hosted GLM on Model Garden.
# Reuses GOOGLE_CLOUD_PROJECT + GOOGLE_SERVICE_ACCOUNT_KEY above.
# Official model docs:
#   https://docs.cloud.google.com/vertex-ai/generative-ai/docs/maas/zaiorg/glm-5
# Use glm-5.1 for direct Z.AI. For Vertex partner aliases that still expose MaaS naming,
# override this to glm-5-maas from /admin/ai-provider.
ZAI_TEXT_MODEL="glm-5.1"
ZAI_VERTEX_LOCATION="global"
#
# Optional direct Z.AI API fallback instead of Vertex:
#   https://api.z.ai/api/paas/v4/
#ZAI_API_KEY=""
#ZAI_BASE_URL="https://api.z.ai/api/paas/v4/"
# Direct image generation model
ZAI_IMAGE_MODEL="glm-image"

# --- Dedalus (required when AI_PROVIDER=dedalus) ---
DEDALUS_API_KEY=""
DEDALUS_MODEL="google/gemini-3-flash-preview"
DEDALUS_IMAGE_MODEL="openai/dall-e-3"

# Supabase Storage / client (optional)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Vercel Marketplace uses this name for the browser-safe key; app accepts it if ANON_KEY is unset:
#NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Base chain + POMP (EAS attestations) ---
# RPC for server-side minting + webhooks (Vercel).
BASE_RPC_URL="https://mainnet.base.org"
# Issuer wallet (attester). No protocol fee — you pay Base gas only.
POMP_ISSUER_PRIVATE_KEY=""
# Register schema once: node scripts/register-pomp-eas-schema.mjs (or Base EASScan UI)
POMP_EAS_SCHEMA_UID=""
# Optional override; default is 0x4200000000000000000000000000000000000021 on Base / Base Sepolia.
EAS_CONTRACT_ADDRESS=""
# Alchemy webhook HMAC (Custom Webhook → your /api/webhook/onchain)
ALCHEMY_WEBHOOK_SECRET=""
# HiClaw session rows + on-chain sync — PostgreSQL only.
# Leave HICLAW_POSTGRES_URL empty to reuse DATABASE_URL (recommended for one Supabase/Postgres stack).
HICLAW_POSTGRES_URL=""

# WeChat Mini Program auth
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# Optional: accept POST /api/debug/wechat-client-log from the Mini Program (see wechat/README.md). Required in production for that route to return 200.
#WECHAT_CLIENT_LOG="1"

# Optional debug APIs. Keep unset in production unless actively diagnosing.
# Read-only `/api/debug/*` routes require admin auth and `DEBUG_API_ENABLED=1` in production.
# Destructive debug routes such as clean/delete/db-push also require `DEBUG_MUTATION_ENABLED=1`.
#DEBUG_API_ENABLED="1"
#DEBUG_MUTATION_ENABLED="1"

# WeChat Pay (optional) — JSAPI `/api/bookings/wechat-pay` if you keep in-app WeChat payments enabled.
# Web booking: prefer Stripe Checkout; enable WeChat Pay there with STRIPE_CHECKOUT_WECHAT_PAY (see Stripe docs).
# Webhook: /api/webhooks/wechat-pay for JSAPI confirmations.
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""         # exactly 32 chars
WECHAT_PAY_CERT_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""        # PEM full text or key body without BEGIN/END
WECHAT_PAY_NOTIFY_URL=""         # e.g. https://expert-network.vercel.app/api/webhooks/wechat-pay
# Service-provider + profit sharing (marketplace): set WECHAT_PAY_PARTNER_MODE=true, store 特约商户号 on Expert.wechatSubMchId
#WECHAT_PAY_PARTNER_MODE="false"
#WECHAT_PAY_PLATFORM_MCH_ID=""   # platform (服务商) mchid receiving the fee; defaults to WECHAT_PAY_MCH_ID
#WECHAT_PAY_PLATFORM_MERCHANT_NAME=""  # legal name for encrypted receiver field
#WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM="" # WeChat Pay platform public key PEM (OAEP encrypt name)
#WECHAT_PAY_PLATFORM_CERT_SERIAL=""    # Wechatpay-Serial for API requests (cert serial or pub key id)

# Optional: WeChat subscribe message templates
#WECHAT_TPL_BOOKING_CONFIRMED=""
#WECHAT_TPL_BOOKING_CANCELLED=""
#WECHAT_TPL_BOOKING_RESCHEDULED=""
#WECHAT_TPL_LOCATION_UPDATED=""
#WECHAT_TPL_SESSION_REMINDER=""

# --- Telegram (optional but required for Mini App auth, bot notifications, and Telegram Pay) ---
# Token from @BotFather (HTTP API). Store only in `.env.local` / Vercel — never commit the real value.
# Sync local + Vercel (production & preview): `export TELEGRAM_BOT_TOKEN=... && npm run vercel:env:telegram` (requires `npx vercel link`).
#TELEGRAM_BOT_TOKEN=""
# Webhook for bot updates (inline queries, payments, /start): https://YOUR_DOMAIN/api/webhooks/telegram
# Mini App: set the Web App URL in @BotFather to your deployed site (same NEXTAUTH_URL origin is typical).
# Optional but recommended for TON Connect inside Telegram Mini App:
# direct Mini App return URL used after wallet handoff, e.g. `https://t.me/<bot_username>/<app_name>`
#NEXT_PUBLIC_TELEGRAM_TWA_RETURN_URL=""
#
# Telegram Pay only (`/api/bookings/telegram-payment`, webhook pre_checkout): payment provider token from BotFather → Payments
#TELEGRAM_PAYMENT_PROVIDER_TOKEN=""

# --- AI Voice Chat ---
# Mode: "async" (default) = voice messaging, "realtime" = timed realtime AI chat, "both" = user picks
VOICE_CHAT_MODE="async"
# Async and realtime voice chat require DashScope/Qwen via DASHSCOPE_API_KEY.
# Async voice chat currently has a 5-reply free cap.
# Optional: built-in Qwen voice name when expert has no voice clone (default: Cherry / Ethan by gender)
#VOICE_CHAT_DEFAULT_VOICE="Ethan"

# --- Premium Live Consultation (Tencent TRTC) ---
# Tencent console terminology: SDKAppID + SDKSecretKey
#TRTC_APP_ID="1400000000"
#TRTC_SECRET_KEY=""
# Backward-compatible alias for older scripts/docs if needed:
#TRTC_APP_SECRET=""
# H&G tokens debited once per premium-live booking when `/api/trtc/token` is first issued.
#TRTC_PREMIUM_LIVE_TOKENS="500"
# How early participants may request room credentials before the booking start.
#TRTC_PREJOIN_SECONDS="900"
# Grace period after booking end for reconnect/clean exit.
#TRTC_POST_END_GRACE_SECONDS="900"

# Admin AI-provider switcher (server-only, optional)
# Needed for /admin/ai-provider to update Vercel envs and trigger redeploys.
VERCEL_MANAGEMENT_TOKEN=""
VERCEL_MANAGED_TEAM_ID=""
VERCEL_MANAGED_PROJECT=""
# Optional deploy hook so provider changes redeploy automatically.
#VERCEL_DEPLOY_HOOK_URL="https://api.vercel.com/v1/integrations/deploy/..."

# Public (browser) — H&G ERC-20 + EAS schema deep links on /reputation
NEXT_PUBLIC_HG_TOKEN_ADDRESS=""
NEXT_PUBLIC_POMP_EAS_SCHEMA_UID=""
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# Stripe (set in Vercel — server-side; use Test mode keys until you go live)
# Dashboard: https://dashboard.stripe.com/apikeys — never commit real secret keys to git.
#STRIPE_SECRET_KEY=""
#STRIPE_WEBHOOK_SECRET=""

# OpenTelemetry — service name in traces (Vercel dashboard / Braintrust drain). Default: expert-network
#OTEL_SERVICE_NAME="expert-network"

# Playwright e2e (optional — not read by Next.js; export or use in shell)
#PLAYWRIGHT_BASE_URL="http://localhost:5000"
#PLAYWRIGHT_EXPERT_ID=""
#PLAYWRIGHT_STORAGE_STATE="./e2e/.auth/user.json"

# Storage backend — overridable via /admin/system-config without redeploy.
# Values: "db" (legacy base64) | "vercel" | "gcs" | "tencent-cos"
#STORAGE_PROVIDER="db"
# Vercel Blob
#BLOB_READ_WRITE_TOKEN=""
# Google Cloud Storage
#GCS_BUCKET_NAME=""
# Tencent COS — used for WeChat-originated traffic (see tri-cloud-architecture.md).
# CAM keys: https://console.cloud.tencent.com/cam/capi
#TENCENT_COS_SECRET_ID=""
#TENCENT_COS_SECRET_KEY=""
# Bucket name with AppID suffix, e.g. "hg-wechat-1300000000"
#TENCENT_COS_BUCKET=""
# Region, e.g. "ap-guangzhou" or "ap-singapore"
#TENCENT_COS_REGION=""
#PLAYWRIGHT_RUN_CHECKOUT_TEST=0
