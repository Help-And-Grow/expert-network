# ═══════════════════════════════════════════════════════════════════════════
# Expert Network — environment variables (intern-friendly reference)
# ═══════════════════════════════════════════════════════════════════════════
#
# 🎯 GOLDEN RULES
#   1. Vercel Production env is the SINGLE SOURCE OF TRUTH.
#      → Read/write via the Vercel dashboard or `vercel env <add|ls>`.
#   2. NEVER commit a real secret. This file contains only placeholders.
#   3. For the runtime control plane (AI providers, storage, regions, chains),
#      use /admin/providers — it edits a DB-backed registry without a redeploy.
#   4. Production fails fast if these three are missing or weak:
#        DATABASE_URL, NEXTAUTH_URL, AUTH_SECRET (≥32 chars).
#      Emergency local bypass (NEVER on Vercel): SKIP_ENV_VALIDATION=1
#
# 🚀 LOCAL QUICK START (intern path — 5 steps)
#   1. cp .env.example .env.local      (gitignored — your local secrets)
#   2. Pull values from Vercel:
#        npx vercel link               (one time)
#        npx vercel env pull .env.local --environment=development --yes
#   3. npm install                     (runs prisma migrate against your DB)
#   4. npm run dev                     (Next.js on :5000)
#   5. npm test                        (vitest unit tests; ~300ms)
#
#   Then open http://localhost:5000 and sign in with the dev shortcut
#   `DEV_AUTH_EMAIL` (see § Auth — Local dev shortcut below).
#
# 📚 DEEPER DOCS
#   - docs/ENV.md                                             — grouped reference
#   - docs/exec-plans/active/postgres-cutover-runbook.md      — Cloud SQL ops
#   - docs/references/vercel-environments-solo-pm.md          — Vercel CLI cheatsheet
#   - docs/design-docs/architecture.md §3 — AI routing + per-surface chains
#
# ═══════════════════════════════════════════════════════════════════════════
# §1 · CORE  (REQUIRED in production)
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string (Prisma).
# Production = Google Cloud SQL `hg-postgres-prod` (asia-southeast1).
# Cloud SQL URLs MUST end with `?sslmode=require&sslaccept=accept_invalid_certs`
# so Prisma's Rust query engine accepts the managed-CA TLS handshake.
DATABASE_URL="postgresql://user:password@localhost:5432/expert_network?schema=public"

# Canonical public origin. Production = https://www.help-and-grow.com
NEXTAUTH_URL="http://localhost:3000"

# Auth.js v5 JWT signing secret. Generate with:  openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional aliases — if set, KEEP equal to the canonical values above.
#AUTH_URL="http://localhost:3000"
#NEXTAUTH_SECRET=""

# OpenTelemetry service name (Vercel traces). Default: expert-network
#OTEL_SERVICE_NAME="expert-network"

# ═══════════════════════════════════════════════════════════════════════════
# §2 · AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════════

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Production callback: https://www.help-and-grow.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Magic-link email (Nodemailer) ─────────────────────────────────────────
# Path A — Gmail SMTP (use a Google App Password if 2FA is on).
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="you@gmail.com"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Help and Grow <you@gmail.com>"
# Path B — Resend SMTP: set EMAIL_SERVER_HOST=smtp.resend.com, _USER=resend,
# _PASSWORD=<resend api key>, then EMAIL_FROM must match Resend rules.

# ─── Local dev shortcut (next dev only) ────────────────────────────────────
# Skips Google + magic link — adds "Continue as local dev" on /auth/signin.
#DEV_AUTH_EMAIL="dev@localhost"
#DEV_AUTH_ROLE="ADMIN"   # USER when unset

# ─── Production-safe Playwright login ──────────────────────────────────────
# Hidden — no UI button. Set only on deployments you e2e-test.
#E2E_AUTH_EMAIL="e2e-admin@example.com"
#E2E_AUTH_ROLE="ADMIN"
#E2E_AUTH_TOKEN="generate-a-long-random-token-at-least-24-chars"

# ═══════════════════════════════════════════════════════════════════════════
# §3 · AI PROVIDERS
# ═══════════════════════════════════════════════════════════════════════════
#
# 💡 Runtime routing is configured at /admin/providers (DB-backed). Env vars
#    here are the BOOT-TIME FALLBACK + per-provider API keys. Once seeded,
#    the registry + routing scopes + route overrides decide which provider
#    handles which request, without redeployment.
#
#    Default per-surface chains (see docs/design-docs/architecture.md §3.2):
#      Web / Telegram / REST   →  Qwen → Gemini
#      WeChat MP (Intl + CN)   →  Hunyuan (no cross-cloud fallback by design)
#      Web search grounding    →  Always Gemini (always-on dependency)

# Head of the Web/Telegram chain. Used as fallback when the registry is empty.
AI_PROVIDER="qwen"
# Region-aware override for WeChat-originated traffic. (Deprecated since
# Phase-3 routing scopes — kept for boot-time fallback.)
#WECHAT_AI_PROVIDER="hunyuan"

# ─── Qwen / DashScope (default primary) ────────────────────────────────────
# Get a key at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=""
QWEN_TEXT_MODEL="qwen3.6-plus"
QWEN_IMAGE_MODEL="wan2.7-image-pro"

# ─── Gemini (default fallback + always-on for search grounding) ────────────
# Option A — Vertex AI (preferred: GCP credits + higher quotas).
#   Requires a base64-encoded service-account JSON.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="asia-southeast1"
GOOGLE_SERVICE_ACCOUNT_KEY=""
GEMINI_TEXT_MODEL="gemini-3-flash-preview"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image-preview"
# Optional: separate Vertex region for image generation if your main region
# (e.g. asia-southeast1) doesn't host the image model yet.
#GEMINI_IMAGE_VERTEX_LOCATION="global"
#GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
#
# Option B — AI Studio API key (simpler, free tier limited).
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Tencent Hunyuan (WeChat MP only) ──────────────────────────────────────
# Get a key at https://console.tencentcloud.com/cam (Hunyuan service permissions).
#HUNYUAN_API_KEY=""
#HUNYUAN_TEXT_MODEL="hunyuan-turbo"  # or hunyuan-pro / -standard / -lite

# ─── Z.AI (optional — Vertex AI Model Garden GLM) ──────────────────────────
# Reuses GOOGLE_CLOUD_PROJECT + GOOGLE_SERVICE_ACCOUNT_KEY above.
#ZAI_TEXT_MODEL="glm-5.1"
#ZAI_VERTEX_LOCATION="global"
#ZAI_IMAGE_MODEL="glm-image"
# Direct Z.AI API fallback (instead of Vertex):
#ZAI_API_KEY=""
#ZAI_BASE_URL="https://api.z.ai/api/paas/v4/"

# ─── OpenAI (optional fallback) ────────────────────────────────────────────
#OPENAI_API_KEY=""
#OPENAI_TEXT_MODEL="gpt-5.2"
#OPENAI_IMAGE_MODEL="gpt-image-1.5"

# ─── Volcengine / BytePlus ModelArk (Doubao text + Seedream image) ────────
# • volcengine: used by the jlzxwt8/expert-network IGA Pages CN production
#   deploy (post company-setup + ICP filing). Endpoint: ark.cn-beijing.volces.com.
# • byteplus: used by the Help-And-Grow/expert-network demo mirror for
#   hackathon / investor / credit-grant showcases of the ByteDance integration.
#   Endpoint: ark.ap-southeast.bytepluses.com.
# Both share the same code path via region-aware provider selection in
# src/lib/ai/{volcengine,byteplus}.ts. See
# docs/exec-plans/active/iga-pages-volcengine-deployment.md.
#
# Set chain via SystemConfig `AI_TEXT_PROVIDER_CHAIN` / `IMAGE_PROVIDER_CHAIN`
# from /admin/providers (no redeploy). Model IDs accept either the canonical
# alias (doubao-seed-1.6-flash, doubao-seedream-4.0-flash) or your ModelArk
# endpoint id (ep-2026xxxxxx-yyyy) from
# https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint.
#
# Mainland (volcengine)
#VOLCENGINE_API_KEY=""
#VOLCENGINE_MODEL_ID="doubao-seed-1.6-flash"
#VOLCENGINE_IMAGE_MODEL="doubao-seedream-4.0-flash"
#
# Overseas / demo (byteplus)
#BYTEPLUS_API_KEY=""
#BYTEPLUS_MODEL_ID="doubao-seed-1.6-flash"
#BYTEPLUS_IMAGE_MODEL="doubao-seedream-4.0-flash"

# ─── AI Voice Chat ─────────────────────────────────────────────────────────
# Modes: "async" (voice messaging, default), "realtime" (timed AI chat), "both"
VOICE_CHAT_MODE="async"
# Built-in fallback voice when the expert has no clone. Default: Cherry/Ethan by gender.
#VOICE_CHAT_DEFAULT_VOICE="Ethan"

# ═══════════════════════════════════════════════════════════════════════════
# §4 · STORAGE
# ═══════════════════════════════════════════════════════════════════════════
#
# 💡 Active provider editable at /admin/providers?tab=storage (no redeploy).
#    WeChat-originated traffic auto-routes to Tencent COS when configured.
#
# Values: "vercel" | "gcs" | "tencent-cos" | "db" (legacy base64).

#STORAGE_PROVIDER="vercel"

# ─── Vercel Blob ──────────────────────────────────────────────────────────
#BLOB_READ_WRITE_TOKEN=""

# ─── Google Cloud Storage ─────────────────────────────────────────────────
# Reuses GOOGLE_CLOUD_PROJECT + GOOGLE_SERVICE_ACCOUNT_KEY above.
#GCS_BUCKET_NAME=""

# ─── Tencent COS (WeChat traffic) ─────────────────────────────────────────
# CAM keys: https://console.cloud.tencent.com/cam/capi
#TENCENT_COS_SECRET_ID=""
#TENCENT_COS_SECRET_KEY=""
#TENCENT_COS_BUCKET=""        # name + AppID suffix, e.g. hg-wechat-1300000000
#TENCENT_COS_REGION=""        # e.g. ap-guangzhou

# ═══════════════════════════════════════════════════════════════════════════
# §5 · EMAIL NOTIFICATIONS  (booking confirmations + reminders)
# ═══════════════════════════════════════════════════════════════════════════
# Magic-link sign-in still uses Nodemailer (§2). This is for transactional emails.

# Resend API — `src/lib/email.ts`. Free-tier recipients are restricted; verify a
# domain at https://resend.com/domains for production sends.
RESEND_API_KEY=""
RESEND_EMAIL_FROM="Help & Grow <onboarding@resend.dev>"

# ═══════════════════════════════════════════════════════════════════════════
# §6 · PAYMENTS
# ═══════════════════════════════════════════════════════════════════════════

# ─── Stripe (web booking checkout) ─────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys (Test mode until live).
# Set in Vercel — never commit real keys.
#STRIPE_SECRET_KEY=""
#STRIPE_WEBHOOK_SECRET=""
# Method opt-outs (set false to disable a method on Stripe Checkout):
#STRIPE_CHECKOUT_GRABPAY="false"
#STRIPE_CHECKOUT_WECHAT_PAY="false"
#STRIPE_CHECKOUT_ALIPAY="false"

# ─── PayNow (Singapore primary) ────────────────────────────────────────────
PAYNOW_UEN=""                            # e.g. 201403121W
PAYNOW_COMPANY_NAME="Help & Grow"        # ≤25 ASCII chars (QR display)
PAYNOW_EDITABLE_AMOUNT="false"           # true = sender can edit; false = locked

# ─── Telegram Pay (`/api/bookings/telegram-payment`) ───────────────────────
#TELEGRAM_PAYMENT_PROVIDER_TOKEN=""       # @BotFather → Payments

# ─── WeChat Pay JSAPI (`/api/bookings/wechat-pay`, optional) ───────────────
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""                 # exactly 32 chars
WECHAT_PAY_CERT_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""                # PEM full text
WECHAT_PAY_NOTIFY_URL=""                 # https://YOUR_DOMAIN/api/webhooks/wechat-pay
# Marketplace mode (服务商 + 分账) — store sub-merchant id in Expert.wechatSubMchId
#WECHAT_PAY_PARTNER_MODE="false"
#WECHAT_PAY_PLATFORM_MCH_ID=""
#WECHAT_PAY_PLATFORM_MERCHANT_NAME=""
#WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=""
#WECHAT_PAY_PLATFORM_CERT_SERIAL=""

# ═══════════════════════════════════════════════════════════════════════════
# §7 · MESSAGING CHANNELS
# ═══════════════════════════════════════════════════════════════════════════

# ─── WeChat Mini Program ───────────────────────────────────────────────────
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# Set to "1" in production to accept the MP debug-log endpoint.
#WECHAT_CLIENT_LOG="1"
# WeChat subscribe-message templates (optional notifications).
#WECHAT_TPL_BOOKING_CONFIRMED=""
#WECHAT_TPL_BOOKING_CANCELLED=""
#WECHAT_TPL_BOOKING_RESCHEDULED=""
#WECHAT_TPL_LOCATION_UPDATED=""
#WECHAT_TPL_SESSION_REMINDER=""

# ─── Telegram (Mini App + bot) ─────────────────────────────────────────────
# @BotFather → bot token. Sync local + Vercel:
#   export TELEGRAM_BOT_TOKEN=... && npm run vercel:env:telegram
#TELEGRAM_BOT_TOKEN=""
# TON Connect Mini App return URL: https://t.me/<bot>/<app>
#NEXT_PUBLIC_TELEGRAM_TWA_RETURN_URL=""

# ─── Tencent TRTC (premium live consultation) ──────────────────────────────
#TRTC_APP_ID="1400000000"
#TRTC_SECRET_KEY=""
#TRTC_CALLBACK_KEY=""                    # Tencent console 回调密钥
#TRTC_PREMIUM_LIVE_TOKENS="500"          # tokens debited per live booking
#TRTC_PREJOIN_SECONDS="900"              # how early participants may join
#TRTC_POST_END_GRACE_SECONDS="900"       # reconnect grace after end

# ═══════════════════════════════════════════════════════════════════════════
# §8 · WEB3 / POMP (EAS attestations on Base)
# ═══════════════════════════════════════════════════════════════════════════

BASE_RPC_URL="https://mainnet.base.org"
POMP_ISSUER_PRIVATE_KEY=""               # attester wallet (you pay Base gas)
POMP_EAS_SCHEMA_UID=""                   # register once via scripts/register-pomp-eas-schema.mjs
#EAS_CONTRACT_ADDRESS=""                 # default 0x4200..0021 on Base
ALCHEMY_WEBHOOK_SECRET=""                # HMAC for /api/webhook/onchain

# ═══════════════════════════════════════════════════════════════════════════
# §9 · ADMIN CONTROL PLANE  (/admin/providers + crons)
# ═══════════════════════════════════════════════════════════════════════════
#
# These unlock atomic apply, deploy retry, drift detection, and audited writes
# from /admin/providers. Without them, the admin page still functions but only
# writes to the DB (no Vercel env sync, no redeploy trigger, no drift cron).

# Vercel personal access token — https://vercel.com/account/tokens (Full Access)
VERCEL_MANAGEMENT_TOKEN=""
VERCEL_MANAGED_TEAM_ID=""                # e.g. team_xxxxxxxxxxxxxxx
VERCEL_MANAGED_PROJECT="expert-network"  # project name OR project id (prj_xxx)
# Project → Settings → Git → Deploy Hooks → branch `main`
#VERCEL_DEPLOY_HOOK_URL="https://api.vercel.com/v1/integrations/deploy/..."

# Cron auth — required for /api/cron/charge-remainder + /api/cron/provider-drift.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ═══════════════════════════════════════════════════════════════════════════
# §10 · OPTIONAL FEATURES
# ═══════════════════════════════════════════════════════════════════════════

# ─── Expert memory (mem9) + semantic search ────────────────────────────────
# Hosted long-term memory for experts. Per-expert keys live in Expert.mem9SpaceId.
#MEM9_ENABLED=1
#MEM9_API_BASE="https://api.mem9.ai"
#MEM9_AGENT_ID="help-grow-platform"
# Mirror to Postgres pgvector (run admin/migrate first; needs Gemini for embeddings).
#USE_PGVECTOR_MEMORY=1
#PGVECTOR_DATABASE_URL=""                # defaults to DATABASE_URL
# Semantic pre-rank toggle — prefer the /admin/providers toggle after backfill.
#EXPERT_SEARCH_VECTOR_PRERANK=false

# ─── Inngest (background jobs) ─────────────────────────────────────────────
# Register https://YOUR_DOMAIN/api/inngest in Inngest Cloud + set keys on Vercel.
#INNGEST_SIGNING_KEY=""
#INNGEST_EVENT_KEY=""
# Skip the Vercel cron when Inngest runs the same maintenance:
#CRON_DELEGATED_TO_INNGEST=1

# ─── Google Places (offline meetup address autocomplete) ───────────────────
# Cloud Console → enable "Places API (New)"; restrict the key to your domain/IPs.
#GOOGLE_PLACES_API_KEY=""
#GOOGLE_PLACES_REGION_CODES="sg"          # comma-separated ISO codes; e.g. sg,my

# ─── Debug API gating ──────────────────────────────────────────────────────
# Read-only `/api/debug/*` requires `DEBUG_API_ENABLED=1` in production.
# Destructive routes (clean/delete/db-push) ALSO require DEBUG_MUTATION_ENABLED=1.
#DEBUG_API_ENABLED="1"
#DEBUG_MUTATION_ENABLED="1"

# ─── Playwright e2e (shell-only, not read by Next.js) ──────────────────────
#PLAYWRIGHT_BASE_URL="http://localhost:5000"
#PLAYWRIGHT_EXPERT_ID=""
#PLAYWRIGHT_STORAGE_STATE="./e2e/.auth/user.json"
#PLAYWRIGHT_RUN_CHECKOUT_TEST=0

# ─── Local dev: mimic vendor showcase deploys ──────────────────────────────
#VENDOR_ALIBABACLOUD_DEMO="1"

# ═══════════════════════════════════════════════════════════════════════════
# §11 · PUBLIC (NEXT_PUBLIC_*)  — exposed to browser, never put secrets here
# ═══════════════════════════════════════════════════════════════════════════

# H&G ERC-20 + EAS schema deep links shown on /reputation
NEXT_PUBLIC_HG_TOKEN_ADDRESS=""
NEXT_PUBLIC_POMP_EAS_SCHEMA_UID=""
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
# Telegram Mini App TON Connect return URL (mirror of §7):
#NEXT_PUBLIC_TELEGRAM_TWA_RETURN_URL=""
