# Production: DATABASE_URL, NEXTAUTH_URL, and AUTH_SECRET or NEXTAUTH_SECRET (32+ chars) are validated at startup.
# Auth.js v5 prefers AUTH_SECRET; NEXTAUTH_SECRET still works as an alias.
# Emergency bypass (not for Vercel): SKIP_ENV_VALIDATION=1
#
# Vercel CLI — push many vars at once: put KEY=value lines in `.env.vercel.sync` (gitignored), then:
#   npm run vercel:env:apply -- production ./.env.vercel.sync
# Requires `vercel link` + `vercel login`. Inspect names: `npm run vercel:env:ls`; pull down: `npm run vercel:env:pull`.

# Optional: mirror expert memories to Postgres pgvector (run admin/migrate on Postgres first; needs OPENAI_API_KEY for embeddings)
#USE_PGVECTOR_MEMORY=1
#PGVECTOR_DATABASE_URL="postgresql://..."  # defaults to DATABASE_URL when Postgres

# Optional: Inngest — register https://YOUR_DOMAIN/api/inngest in Inngest Cloud; set signing key on Vercel
#INNGEST_SIGNING_KEY=""
#INNGEST_EVENT_KEY=""
# When Inngest runs the daily remainder job, skip Vercel cron work:
#CRON_DELEGATED_TO_INNGEST=1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/expert_network?schema=public"

# NextAuth / Auth.js v5
NEXTAUTH_URL="http://localhost:3000"
# Production: prefer AUTH_SECRET (Vercel). NEXTAUTH_SECRET still works as an alias in code.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
#NEXTAUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local dev only (`next dev`): enables "Continue as local dev" on /auth/signin — no Google or magic link.
#DEV_AUTH_EMAIL="dev@localhost"
#DEV_AUTH_ROLE="ADMIN"

# Production-safe hidden browser E2E login. No sign-in button is shown.
# Set these only on the deployments you want to verify with Playwright.
#E2E_AUTH_EMAIL="e2e-admin@example.com"
#E2E_AUTH_ROLE="ADMIN"
#E2E_AUTH_TOKEN="generate-a-long-random-token-at-least-24-chars"

# Email (Magic Link) — Nodemailer in src/auth.ts; provider id is "nodemailer".
#
# Path A — Gmail SMTP: FROM must be the same Gmail address as EMAIL_SERVER_USER (or a Gmail
# "Send mail as" verified alias). Use an App Password if the account has 2FA.
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="you@gmail.com"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Help and Grow <you@gmail.com>"
#
# Resend API — booking confirmation + 1h reminders only (`src/lib/email.ts`). Not used for magic-link sign-in.
# Free tier: recipients are restricted (e.g. your signup email / verified test inboxes). Use for internal QA until
# you verify a domain and upgrade for real user emails.
RESEND_API_KEY=""
RESEND_EMAIL_FROM="Help & Grow <onboarding@resend.dev>"
#
# Optional: magic link via Resend SMTP instead of Gmail — set EMAIL_* to smtp.resend.com / user resend / API key as password; then EMAIL_FROM must match Resend rules.

# Stripe — booking checkout (`/api/bookings/checkout`). Set STRIPE_SECRET_KEY in Vercel (not committed).
# Payment methods (when enabled in Dashboard): PayNow → GrabPay → WeChat Pay → Alipay → card.
# Apple Pay / Google Pay: enable in Dashboard; they show on the card step (verify domain for Apple Pay in Dashboard).
# Opt out of a method if session creation errors in test or a region does not support it:
#STRIPE_CHECKOUT_GRABPAY="false"
#STRIPE_CHECKOUT_WECHAT_PAY="false"
#STRIPE_CHECKOUT_ALIPAY="false"

# PayNow (Singapore) — primary web payment flow
# UEN of receiving entity, e.g. 201403121W
PAYNOW_UEN=""
# Displayed in QR merchant name (max 25 ASCII chars)
PAYNOW_COMPANY_NAME="Help & Grow"
# true => sender can edit amount; false => amount locked from booking
PAYNOW_EDITABLE_AMOUNT="false"

# AI Provider — "qwen" (default, Alibaba DashScope) | "dedalus" | "gemini" | "openai" | "zai"
AI_PROVIDER="qwen"

# --- Gemini (required when AI_PROVIDER=gemini) ---
# Also needed for Google Search grounding & PDF extraction in qwen/openai modes.
#
# Option A: Vertex AI (recommended — uses GCP credits, higher quotas)
#   1. Enable Vertex AI API at console.cloud.google.com
#   2. Provide a base64-encoded service-account JSON on Vercel
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_SERVICE_ACCOUNT_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
#
# Option B: AI Studio API key (simpler, free tier has limited image quota)
#   Get your key at https://aistudio.google.com
GEMINI_API_KEY=""

# --- Qwen / DashScope (required when AI_PROVIDER=qwen) ---
#   Get your key at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=""

# --- OpenAI (required when AI_PROVIDER=openai) ---
#   Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# --- Z.ai (required when AI_PROVIDER=zai) ---
# Preferred path for this repo: Vertex AI-hosted GLM on Model Garden.
# Reuses GOOGLE_CLOUD_PROJECT + GOOGLE_SERVICE_ACCOUNT_KEY above.
# Official model docs:
#   https://docs.cloud.google.com/vertex-ai/generative-ai/docs/maas/zaiorg/glm-5
ZAI_TEXT_MODEL="glm-5-maas"
ZAI_VERTEX_LOCATION="global"
#
# Optional direct Z.AI API fallback instead of Vertex:
#   https://api.z.ai/api/paas/v4/
#ZAI_API_KEY=""
#ZAI_BASE_URL="https://api.z.ai/api/paas/v4/"
# If using the direct API, set ZAI_TEXT_MODEL to a direct API model such as:
#ZAI_TEXT_MODEL="glm-4.7-flash"
# Direct image generation model (Vertex path currently falls back to Gemini image generation)
ZAI_IMAGE_MODEL="glm-image"

# Supabase Storage (optional)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Base chain + POMP (EAS attestations) ---
# RPC for server-side minting + webhooks (Vercel).
BASE_RPC_URL="https://mainnet.base.org"
# Issuer wallet (attester). No protocol fee — you pay Base gas only.
POMP_ISSUER_PRIVATE_KEY=""
# Register schema once: node scripts/register-pomp-eas-schema.mjs (or Base EASScan UI)
POMP_EAS_SCHEMA_UID=""
# Optional override; default is 0x4200000000000000000000000000000000000021 on Base / Base Sepolia.
EAS_CONTRACT_ADDRESS=""
# Alchemy webhook HMAC (Custom Webhook → your /api/webhook/onchain)
ALCHEMY_WEBHOOK_SECRET=""
# HiClaw session rows + on-chain sync — PostgreSQL only.
# Leave HICLAW_POSTGRES_URL empty to reuse DATABASE_URL (recommended for one Supabase/Postgres stack).
HICLAW_POSTGRES_URL=""

# WeChat Mini Program auth
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
# Optional: accept POST /api/debug/wechat-client-log from the Mini Program (see wechat/README.md). Required in production for that route to return 200.
#WECHAT_CLIENT_LOG="1"

# WeChat Pay (optional) — JSAPI `/api/bookings/wechat-pay` if you keep in-app WeChat payments enabled.
# Web booking: prefer Stripe Checkout; enable WeChat Pay there with STRIPE_CHECKOUT_WECHAT_PAY (see Stripe docs).
# Webhook: /api/webhooks/wechat-pay for JSAPI confirmations.
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""         # exactly 32 chars
WECHAT_PAY_CERT_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""        # PEM full text or key body without BEGIN/END
WECHAT_PAY_NOTIFY_URL=""         # e.g. https://expert-network.vercel.app/api/webhooks/wechat-pay
# Service-provider + profit sharing (marketplace): set WECHAT_PAY_PARTNER_MODE=true, store 特约商户号 on Expert.wechatSubMchId
#WECHAT_PAY_PARTNER_MODE="false"
#WECHAT_PAY_PLATFORM_MCH_ID=""   # platform (服务商) mchid receiving the fee; defaults to WECHAT_PAY_MCH_ID
#WECHAT_PAY_PLATFORM_MERCHANT_NAME=""  # legal name for encrypted receiver field
#WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM="" # WeChat Pay platform public key PEM (OAEP encrypt name)
#WECHAT_PAY_PLATFORM_CERT_SERIAL=""    # Wechatpay-Serial for API requests (cert serial or pub key id)

# Optional: WeChat subscribe message templates
#WECHAT_TPL_BOOKING_CONFIRMED=""
#WECHAT_TPL_BOOKING_CANCELLED=""
#WECHAT_TPL_BOOKING_RESCHEDULED=""
#WECHAT_TPL_LOCATION_UPDATED=""
#WECHAT_TPL_SESSION_REMINDER=""

# --- AI Voice Chat ---
# Mode: "async" (default) = voice messaging, "realtime" = Agora RTC live call, "both" = user picks
VOICE_CHAT_MODE="async"
# Realtime backend: "ten" (existing TEN agent flow) or "agora" (Agora session + server-generated voice replies)
REALTIME_BACKEND="ten"
# Required for realtime mode:
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
# TEN Agent service URL (Docker/ECS) — required only when REALTIME_BACKEND=ten
#TEN_AGENT_URL="http://localhost:8080"
# Optional: built-in Qwen voice name when expert has no voice clone (default: Cherry / Ethan by gender)
#VOICE_CHAT_DEFAULT_VOICE="Ethan"

# Admin AI-provider switcher (server-only, optional)
# Needed for /admin/ai-provider to update Vercel envs and trigger redeploys.
VERCEL_MANAGEMENT_TOKEN=""
VERCEL_MANAGED_TEAM_ID=""
VERCEL_MANAGED_PROJECT=""
# Optional deploy hook so provider changes redeploy automatically.
#VERCEL_DEPLOY_HOOK_URL="https://api.vercel.com/v1/integrations/deploy/..."

# Public (browser) — H&G ERC-20 + EAS schema deep links on /reputation
NEXT_PUBLIC_HG_TOKEN_ADDRESS=""
NEXT_PUBLIC_POMP_EAS_SCHEMA_UID=""
NEXT_PUBLIC_BASE_RPC_URL="https://mainnet.base.org"
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
