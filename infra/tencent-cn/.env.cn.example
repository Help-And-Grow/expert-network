# CN stack environment variables — copy to .env.cn (gitignored) and fill in.
#
# Used by infra/tencent-cn/scripts/* to migrate TencentDB CN, deploy the
# Next.js SCF, and configure runtime env on the function.

# ─── TencentDB CN (ap-shanghai) ───────────────────────────────────────────
# Connection string for the CN Postgres instance. Get this from:
#   Tencent Cloud CN console → TencentDB for PostgreSQL → <instance> → 详情 → 内/外网地址
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL_CN=

# ─── TCB env (CN) ─────────────────────────────────────────────────────────
TENCENT_CN_ENV_ID=cn-wechat-d1gzncs8i34827c98
TENCENT_CN_REGION=ap-shanghai
TENCENT_CN_FN_NAME=hg-app-cn

# ─── Tencent COS CN (storage) ─────────────────────────────────────────────
# Get keys from https://console.cloud.tencent.com/cam/capi (CN site)
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_CN_COS_BUCKET=
TENCENT_CN_COS_REGION=ap-shanghai

# ─── AI provider ──────────────────────────────────────────────────────────
# Tencent Hunyuan — get key from https://console.cloud.tencent.com/hunyuan/api-key
HUNYUAN_API_KEY=

# ─── App secrets (re-used from existing deploys) ──────────────────────────
NEXTAUTH_SECRET=
WECHAT_APP_ID=wx09d0eb079596060d
WECHAT_APP_SECRET=
