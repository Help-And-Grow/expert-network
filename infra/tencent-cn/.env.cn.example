# Tencent CloudBase WeChat backend variables — copy to .env.cn (gitignored) and fill in.
#
# Current target: international WeChat Mini Program registered through the
# Singapore company. The file/script names still say "cn" for historical
# reasons because this CloudBase env was created first in ap-shanghai.

# ─── TencentDB / synced Postgres (future mainland CloudBase backend) ─────
# Connection string for the Tencent-side Postgres instance. The mainland-CN
# stack will sync from the global primary (Cloud SQL for PostgreSQL in
# asia-southeast1, migrated from Supabase 2026-05-03).
# Get this from:
#   Tencent Cloud CN console → TencentDB for PostgreSQL → <instance> → 详情 → 内/外网地址
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL_CN=

# ─── TCB env ──────────────────────────────────────────────────────────────
TENCENT_CN_ENV_ID=cn-wechat-d1gzncs8i34827c98
TENCENT_CN_REGION=ap-shanghai
TENCENT_CN_FN_NAME=hg-app-cn
WECHAT_STACK_REGION=intl

# ─── Tencent COS (storage) ────────────────────────────────────────────────
# Get keys from https://console.cloud.tencent.com/cam/capi (CN site)
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_CN_COS_BUCKET=
TENCENT_CN_COS_REGION=ap-shanghai

# ─── AI provider ──────────────────────────────────────────────────────────
# Tencent Hunyuan — get key from https://console.cloud.tencent.com/hunyuan/api-key
HUNYUAN_API_KEY=

# ─── App secrets (re-used from existing deploys) ──────────────────────────
# Public CloudBase origin used by Next/Auth.js runtime validation and callback
# URL construction. Do not include a trailing slash.
NEXTAUTH_URL_CN=https://cn-wechat-d1gzncs8i34827c98-1426867475.ap-shanghai.app.tcloudbase.com
NEXTAUTH_SECRET=
WECHAT_APP_ID=wx09d0eb079596060d
WECHAT_APP_SECRET=
